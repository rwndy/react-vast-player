{
  "name": "react-vast-player",
  "version": "0.1.0",
  "description": "Mode-agnostic React video engine with first-class VAST support. No plugins.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rwndy/react-vast-player.git"
  },
  "homepage": "https://github.com/rwndy/react-vast-player#readme",
  "bugs": {
    "url": "https://github.com/rwndy/react-vast-player/issues"
  },
  "keywords": [
    "react",
    "video",
    "vast",
    "ads",
    "player",
    "streaming",
    "feed",
    "shorts",
    "playlist"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./streaming": {
      "import": {
        "types": "./dist/streaming.d.mts",
        "default": "./dist/streaming.mjs"
      },
      "require": {
        "types": "./dist/streaming.d.cts",
        "default": "./dist/streaming.cjs"
      }
    },
    "./feed": {
      "import": {
        "types": "./dist/feed.d.mts",
        "default": "./dist/feed.mjs"
      },
      "require": {
        "types": "./dist/feed.d.cts",
        "default": "./dist/feed.cjs"
      }
    },
    "./playlist": {
      "import": {
        "types": "./dist/playlist.d.mts",
        "default": "./dist/playlist.mjs"
      },
      "require": {
        "types": "./dist/playlist.d.cts",
        "default": "./dist/playlist.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.20.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}